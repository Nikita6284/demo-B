<Window x:Class="StroyMaterials.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО СтройМатериалы - Каталог товаров"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Панель управления -->
            <RowDefinition Height="*"/>
            <!-- Область карточек -->
        </Grid.RowDefinitions>

        <!-- ШАПКА С ЛОГОТИПОМ И ИНФОРМАЦИЕЙ О ПОЛЬЗОВАТЕЛЕ -->
        <Border Grid.Row="0" Background="#DAA520" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="imgLogo" Height="40" Margin="0,0,15,0" Stretch="Uniform"/>

                <TextBlock x:Name="txtTitle" Grid.Column="1" 
                           Text="Каталог товаров" FontSize="20" FontWeight="Bold" 
                           VerticalAlignment="Center" Foreground="White"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="txtUserName" FontSize="14" Foreground="White" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Button x:Name="btnBack" Content="← Назад" Width="80" Height="30"
                            Background="#B8860B" Foreground="White" 
                            Visibility="Collapsed" Click="btnBack_Click" Margin="0,0,5,0"/>

                    <Button x:Name="btnExit" Content="Выйти" Width="80" Height="30"
                            Background="#B8860B" Foreground="White" Click="btnExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="10">
            <StackPanel>
                <!-- Переключение между товарами и заказами -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnProducts" Content="Товары" Width="100" Height="30" Margin="5"
                            Background="#B8860B" Foreground="White" Click="btnProducts_Click"/>
                    <Button x:Name="btnOrders" Content="Заказы" Width="100" Height="30" Margin="5"
                            Background="#B8860B" Foreground="White" Visibility="Collapsed"
                            Click="btnOrders_Click"/>
                </StackPanel>

                <!-- ПАНЕЛЬ ФИЛЬТРОВ  -->
                <Border x:Name="pnlFilters" Visibility="Collapsed" Background="#DAA520" 
                        Padding="10" Margin="0,10,0,0" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Поиск -->
                            <ColumnDefinition Width="200"/>
                            <!-- Фильтр по производителю -->
                            <ColumnDefinition Width="150"/>
                            <!-- Сортировка -->
                            <ColumnDefinition Width="100"/>
                            <!-- Кнопка сброса -->
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSearch" Grid.Column="0" Height="30" 
                                 Text="Поиск..." Foreground="Gray"
                                 GotFocus="txtSearch_GotFocus" LostFocus="txtSearch_LostFocus"
                                 TextChanged="txtSearch_TextChanged"/>
                        <ComboBox x:Name="cmbManufacturer" Grid.Column="1" Height="30" 
                                  Margin="10,0" SelectionChanged="cmbManufacturer_SelectionChanged"/>
                        <ComboBox x:Name="cmbSort" Grid.Column="2" Height="30" 
                                  SelectionChanged="cmbSort_SelectionChanged">
                            <ComboBoxItem Content="По названию" Tag="Name" IsSelected="True"/>
                            <ComboBoxItem Content="Цена ↑" Tag="Price ASC"/>
                            <ComboBoxItem Content="Цена ↓" Tag="Price DESC"/>
                            <ComboBoxItem Content="Скидка ↓" Tag="Discount DESC"/>
                            <ComboBoxItem Content="Остаток ↓" Tag="StockQuantity DESC"/>
                        </ComboBox>
                        <Button x:Name="btnReset" Grid.Column="3" Content="Сброс" Height="30"
                                Background="#B8860B" Foreground="White" Click="btnReset_Click"/>
                    </Grid>
                </Border>

                <!-- ПАНЕЛЬ АДМИНИСТРАТОРА -->
                <Border x:Name="pnlAdmin" Visibility="Collapsed" Background="#E0E0E0" 
                        Padding="10" Margin="0,10,0,0" CornerRadius="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnAdd" Content="➕ Добавить товар" Width="140" Height="30" Margin="5"
                                Background="#B8860B" Foreground="White" Click="btnAdd_Click"/>
                        <Button x:Name="btnEdit" Content="✏ Редактировать товар" Width="160" Height="30" Margin="5"
                                Background="#B8860B" Foreground="White" Click="btnEdit_Click"/>
                        <Button x:Name="btnDelete" Content="🗑 Удалить товар" Width="140" Height="30" Margin="5"
                                Background="#B8860B" Foreground="White" Click="btnDelete_Click"/>
                        <!-- Разделитель -->
                        <Border Width="2" Height="30" Background="#999" Margin="10,0"/>
                        <Button x:Name="btnAddOrder" Content="➕ Добавить заказ" Width="140" Height="30" Margin="5"
                                Background="#B8860B" Foreground="White" Click="btnAddOrder_Click"/>
                        <Button x:Name="btnEditOrder" Content="✏ Редактировать заказ" Width="160" Height="30" Margin="5"
                                Background="#B8860B" Foreground="White" Click="btnEditOrder_Click"/>
                        <Button x:Name="btnDeleteOrder" Content="🗑 Удалить заказ" Width="140" Height="30" Margin="5"
                                Background="#B8860B" Foreground="White" Click="btnDeleteOrder_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ОБЛАСТЬ ДЛЯ ОТОБРАЖЕНИЯ КАРТОЧЕК (ТОВАРЫ ИЛИ ЗАКАЗЫ) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#F9F9F9">
            <WrapPanel x:Name="pnlCards" Margin="15" HorizontalAlignment="Stretch"/>
        </ScrollViewer>
    </Grid>
</Window>