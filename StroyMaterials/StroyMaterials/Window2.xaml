<Window x:Class="StroyMaterials.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Calibri">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Область полей ввода -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Артикул  -->
                <TextBlock Text="Артикул:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtArticle" Height="30" Margin="0,0,0,10" IsEnabled="False"/>

                <!-- Наименование -->
                <TextBlock Text="Наименование:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtName" Height="30" Margin="0,0,0,10"/>

                <!-- Цена -->
                <TextBlock Text="Цена:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtPrice" Height="30" Margin="0,0,0,10"/>

                <!-- Категория  -->
                <TextBlock Text="Категория:" FontWeight="Bold" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbCategory" Height="30" Margin="0,0,0,10"/>

                <!-- Производитель -->
                <TextBlock Text="Производитель:" FontWeight="Bold" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbManufacturer" Height="30" Margin="0,0,0,10"/>

                <!-- Поставщик -->
                <TextBlock Text="Поставщик:" FontWeight="Bold" Margin="0,0,0,3"/>
                <ComboBox x:Name="cmbSupplier" Height="30" Margin="0,0,0,10"/>

                <!-- Скидка -->
                <TextBlock Text="Скидка (%):" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDiscount" Height="30" Text="0" Margin="0,0,0,10"/>

                <!-- Количество -->
                <TextBlock Text="Количество:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtQuantity" Height="30" Text="0" Margin="0,0,0,10"/>

                <!-- Единица измерения -->
                <TextBlock Text="Единица измерения:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtUnit" Height="30" Text="шт." Margin="0,0,0,10"/>

                <!-- Описание -->
                <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <!-- Фото -->
                <TextBlock Text="Фото:" FontWeight="Bold" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtPhoto" Grid.Column="0" Height="30" IsReadOnly="True" Background="#F0F0F0"/>
                    <Button x:Name="btnSelectPhoto" Grid.Column="1" Content="Выбрать" Width="80" Height="30" Margin="5,0,0,0"
                            Background="#B8860B" Foreground="White" Click="btnSelectPhoto_Click"/>
                </Grid>

                <!-- Предпросмотр фото -->
                <Border x:Name="photoPreviewBorder" Background="#F0F0F0" Height="100" CornerRadius="5" 
                        Visibility="Collapsed" HorizontalAlignment="Center">
                    <Image x:Name="photoPreview" Height="90" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" Margin="5"
                    Background="#B8860B" Foreground="White" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Margin="5"
                    Background="#B8860B" Foreground="White" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>