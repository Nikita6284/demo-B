<Window x:Class="StroyMaterials.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый заказ"
        Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Calibri">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Клиент -->
            <RowDefinition Height="Auto"/>
            <!-- ComboBox клиент -->
            <RowDefinition Height="Auto"/>
            <!-- Пункт выдачи -->
            <RowDefinition Height="Auto"/>
            <!-- ComboBox пункт выдачи -->
            <RowDefinition Height="Auto"/>
            <!-- Дата доставки -->
            <RowDefinition Height="Auto"/>
            <!-- DatePicker -->
            <RowDefinition Height="Auto"/>
            <!-- Статус -->
            <RowDefinition Height="Auto"/>
            <!-- ComboBox статус -->
            <RowDefinition Height="Auto"/>
            <!-- Добавление товаров (заголовок) -->
            <RowDefinition Height="Auto"/>
            <!-- Панель добавления -->
            <RowDefinition Height="Auto"/>
            <!-- Добавленные товары (заголовок) -->
            <RowDefinition Height="Auto"/>
            <!-- Список товаров -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- КЛИЕНТ -->
        <TextBlock Grid.Row="0" Text="Клиент:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbClient" Grid.Row="1" Height="35" Margin="0,0,0,15" 
                  DisplayMemberPath="FullName" SelectedValuePath="UserID"/>

        <!-- ПУНКТ ВЫДАЧИ -->
        <TextBlock Grid.Row="2" Text="Пункт выдачи:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbPickup" Grid.Row="3" Height="35" Margin="0,0,0,15" 
                  DisplayMemberPath="Address" SelectedValuePath="PointID"/>

        <!-- ДАТА ДОСТАВКИ -->
        <TextBlock Grid.Row="4" Text="Дата доставки:" FontWeight="Bold" Margin="0,0,0,5"/>
        <DatePicker x:Name="dpDelivery" Grid.Row="5" Height="35" Margin="0,0,0,15"/>

        <!-- СТАТУС ЗАКАЗА -->
        <TextBlock Grid.Row="6" Text="Статус заказа:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="cmbStatus" Grid.Row="7" Height="35" Margin="0,0,0,15">
            <ComboBoxItem Content="Новый" IsSelected="True"/>
            <ComboBoxItem Content="Завершен"/>
            <ComboBoxItem Content="Отменен"/>
        </ComboBox>

        <!-- ДОБАВЛЕНИЕ ТОВАРОВ -->
        <TextBlock Grid.Row="8" Text="Добавление товаров в заказ (введите артикул товара):" FontWeight="Bold" Margin="0,10,0,10"/>

        <Border Grid.Row="9" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Артикул -->
                    <ColumnDefinition Width="100"/>
                    <!-- Количество -->
                    <ColumnDefinition Width="80"/>
                    <!-- Кнопка -->
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtArticle" Grid.Column="0" Height="35" Margin="0,0,5,0" Text=""/>
                <TextBox x:Name="txtQuantity" Grid.Column="1" Height="35" Margin="5,0" Text="1" TextAlignment="Center"/>
                <Button x:Name="btnAddProduct" Grid.Column="2" Content="Добавить" Height="35" Background="#B8860B" Foreground="White" Click="btnAddProduct_Click"/>
            </Grid>
        </Border>

        <!-- СПИСОК ДОБАВЛЕННЫХ ТОВАРОВ -->
        <TextBlock Grid.Row="10" Text="Добавленные товары:" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="11" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0,0,0,20">
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lvProducts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:N0} ₽}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="3" Content="❌" Background="Transparent" BorderThickness="0" Click="RemoveProduct_Click" Tag="{Binding}" FontSize="12" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- КНОПКИ -->
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="Сохранить заказ" Width="120" Height="35" Margin="5"
                    Background="#B8860B" Foreground="White" Click="btnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Margin="5"
                    Background="#B8860B" Foreground="White" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>